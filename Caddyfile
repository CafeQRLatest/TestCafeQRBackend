{
	# Slowloris protection. No write timeout: SSE streams are long-lived.
	servers {
		timeouts {
			read_header 10s
			read_body 2m
			idle 2m
		}
	}
}

{$CADDY_SITE_ADDRESS} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /actuator/health* {
		reverse_proxy backend:8080
	}

	handle /actuator/* {
		respond "Forbidden" 403
	}

	handle {
		respond "Not Found" 404
	}
}

{$CADDY_REDIRECT_SITE_ADDRESS} {
	redir {$CADDY_CANONICAL_ORIGIN}{uri} permanent
}
